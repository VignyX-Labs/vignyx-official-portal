# Resend (transactional email for lead notifications) — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=vignyx.labs@gmail.com

# Anti-spam token signing (server-only secret, not NEXT_PUBLIC) — any long random string
LEAD_FORM_SECRET=

# Analytics — each integration no-ops if its var is unset
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# SEO / canonical base URL
NEXT_PUBLIC_SITE_URL=https://vignyx.in
